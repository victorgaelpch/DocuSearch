# Copie este archivo a .env (no se versiona) o defina las variables en PowerShell.
# Nunca escriba contraseñas en claro: genere el hash con
#   python -m backend.app.cli hash-password

# Cuentas locales (DOC-25). Sin hash, la cuenta no existe.
DOCUSEARCH_ADMIN_USERNAME=admin
DOCUSEARCH_ADMIN_PASSWORD_HASH=
DOCUSEARCH_USER_USERNAME=usuario
DOCUSEARCH_USER_PASSWORD_HASH=
DOCUSEARCH_SESSION_IDLE_MINUTES=30
DOCUSEARCH_SESSION_MAX_HOURS=8
DOCUSEARCH_COOKIE_SECURE=false

# Datos y límites
DOCUSEARCH_DATA_DIR=
DOCUSEARCH_MAX_UPLOAD_MB=20
DOCUSEARCH_CHUNK_SIZE=200
DOCUSEARCH_CHUNK_OVERLAP=30
